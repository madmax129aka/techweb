# Copy this file to .env and fill in real values before running the server.

# Postgres connection string (Replit's built-in Postgres/Neon integration)
DATABASE_URL="postgresql://user:password@host:5432/techastra?schema=public"

# JWT signing secret - use a long random string in production
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# UPI payment details used to build the QR deep link
UPI_PAYEE_ID="college@upi"
UPI_PAYEE_NAME="TechAstra Symposium"

# Email (optional). If left blank, the server logs emails to the console
# instead of sending them - safe default for local/prototype use.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TechAstra <no-reply@techastra.dev>"
